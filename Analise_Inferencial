B <- 5000 ## bootstrap pareado por caso
bootstrap_kappas <- function(dados, ponderacao, B = 5000) {
  
  n <- nrow(dados)
  
  resultados <- matrix(
    NA_real_,
    nrow = B,
    ncol = 3,
    dimnames = list(
      NULL,
      c("Kappa_MO", "Kappa_QuPath", "Diferenca")
    )
  )
  
  for (i in seq_len(B)) {
    
    # Reamostrar linhas inteiras: as quatro avaliações
    # de cada caso permanecem juntas.
    indices <- sample(
      seq_len(n),
      size = n,
      replace = TRUE
    )
    
    amostra <- dados[indices, , drop = FALSE]
    
    resultados[i, ] <- tryCatch(
      calcular_kappas_inter(amostra, ponderacao),
      error = function(e) rep(NA_real_, 3)
    )
  }
  
  as.data.frame(resultados)
}

boot_simples <- bootstrap_kappas(
  dados_inferenciais, "unweighted", B
)

boot_linear <- bootstrap_kappas(
  dados_inferenciais, "equal", B
)

boot_quadratico <- bootstrap_kappas(
  dados_inferenciais, "squared", B
)

resumir_bootstrap <- function(observado, bootstrap, ponderacao) {
  
  diferencas <- bootstrap$Diferenca
  diferencas <- diferencas[is.finite(diferencas)]
  
  if (length(diferencas) < 100) {
    warning(
      "Poucas replicações válidas para a ponderação: ",
      ponderacao
    )
  }
  
  # IC de 95% pelo método percentil
  IC <- quantile(
    diferencas,
    probs = c(0.025, 0.975),
    na.rm = TRUE,
    names = FALSE
  )
  
  # Valor de p bilateral aproximado pelo bootstrap
  delta_obs <- unname(observado["Diferenca"])
  
  p_inferior <- (
    sum(diferencas <= 0) + 1
  ) / (
    length(diferencas) + 1
  )
  
  p_superior <- (
    sum(diferencas >= 0) + 1
  ) / (
    length(diferencas) + 1
  )
  
  p_bootstrap <- min(
    1,
    2 * min(p_inferior, p_superior)
  )
  
  data.frame(
    Ponderacao = ponderacao,
    Kappa_MO = unname(observado["Kappa_MO"]),
    Kappa_QuPath = unname(observado["Kappa_QuPath"]),
    Diferenca_QuPath_menos_MO = delta_obs,
    IC95_inferior = IC[1],
    IC95_superior = IC[2],
    Valor_p_bootstrap = p_bootstrap,
    Replicacoes_validas = length(diferencas),
    Diferenca_significativa_IC95 = (
      IC[1] > 0 || IC[2] < 0
    )
  )
}

tabela_inferencial <- rbind(
  resumir_bootstrap(
    observado_simples, boot_simples, "Não ponderado"
  ),
  resumir_bootstrap(
    observado_linear, boot_linear, "Ponderado linear"
  ),
  resumir_bootstrap(
    observado_quadratico, boot_quadratico, "Ponderado quadrático"
  )
)

