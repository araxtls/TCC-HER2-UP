calcular_kappas_inter <- function(dados, ponderacao) {
  
  kappa_MO <- irr::kappa2(
    dados[, c("APMS_MO", "APP_MO")],
    weight = ponderacao
  )$value
  
  kappa_QuPath <- irr::kappa2(
    dados[, c("APMS_QuPath", "APP_QuPath")],
    weight = ponderacao
  )$value
  
  c(
    Kappa_MO = kappa_MO,
    Kappa_QuPath = kappa_QuPath,
    Diferenca = kappa_QuPath - kappa_MO
  )
}

